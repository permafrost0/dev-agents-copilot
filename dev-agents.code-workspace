{
  // 対象PJのソースルート（pom.xml があるフォルダ）は、ここ（name が "source" の path）だけに書く。
  // ツール（tools/*.py）もこの path を読む。区切りは / を使う。
  // 書き換えたら、VS Code の「ファイル → ファイルでワークスペースを開く」でこのファイルを開く。
  // 1つ目のフォルダは必ずこのパッケージにする（ツールとフックの実行場所になる）。
  "folders": [
    { "name": "agents", "path": "." },
    { "name": "source", "path": "C:/pleiades/2026-06/workspace/<PJ名>" }
  ],
  "settings": {
    "chat.useHooks": true,
    "chat.useClaudeHooks": false,
    "github.copilot.chat.codeGeneration.useInstructionFiles": true,
    "chat.tools.terminal.autoApprove": {
      "/^(& )?python3? (\\.[\\\\/])?tools[\\\\/]gate\\.py (check|status|next)\\b/": true,
      "/^(& )?python3? (\\.[\\\\/])?tools[\\\\/](check_artifact|xlsx_dump|metrics)\\.py\\b/": true
    }
  }
}
